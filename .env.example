# Copy to .env for local work. In production set these in the Vercel project settings instead.

# Database. On Neon: DATABASE_URL is the pooled connection string (host contains "-pooler"),
# DIRECT_URL is the direct one. Locally both can be the same.
DATABASE_URL="postgresql://festival:festival@localhost:5432/festival"
DIRECT_URL="postgresql://festival:festival@localhost:5432/festival"

# Session signing key. Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-value"

# Bill photos. Created in Vercel: Storage -> Blob. Leave empty locally (files go to ./uploads).
BLOB_READ_WRITE_TOKEN=""

# Only used by "npm run seed" to create the first admin.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"
